# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores reais
# do seu Firebase Web App: Firebase Console > Configuracoes do projeto > Seus apps
# > SDK setup and configuration.
#
# Sem esse arquivo o app ainda sobe normalmente com dados mockados
# (useMockData: true em src/environments/environment.ts), so o login via
# Firebase Auth nao vai funcionar.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
